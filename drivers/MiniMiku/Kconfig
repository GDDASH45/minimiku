menu "MiniMiku"

config MINIMIKU_MLOG
	bool "MiniMiku logging device (/dev/mlog)"
	default y
	help
	  Enable the MiniMiku logging device.

	  This option provides the MiniMiku-specific /dev/mlog
	  character device for accessing MiniMiku kernel logs.

	  If unsure, say Y.

config MINIMIKU_INIT
	tristate "MiniMiku initialization module"
	help
	  Build the MiniMiku initialization component as a loadable
	  kernel module or include it directly in the kernel.

endmenu
